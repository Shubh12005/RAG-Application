# ==========================================================
# macOS RAG Research Workspace - Environment Configuration
# ==========================================================

# LLM Provider Configuration ("gemini" or "openai")
LLM_PROVIDER=gemini

# Google Gemini API Key (Recommended)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Google Gemini Model Name
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API Key (Optional Fallback)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ==========================================================
# RAG Retrieval Parameters
# ==========================================================
# Number of top chunks to retrieve per question
TOP_K=5

# Document chunk size in characters
CHUNK_SIZE=800

# Overlap between consecutive chunks
CHUNK_OVERLAP=100

# Local embedding model (SentenceTransformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2
